--- !u!114 &1052442279
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1052442278}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f9e58b049775365409c784b424dd65c3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShowroomController
  spaceships:
  - name: Default Ship
    subtitle: 'Playable Class: Interceptor'
    description: Standard issue terrestrial defender ship. Balanced, reliable, and
      equipped with a standard pulse cannon. Ideal for all recruits starting their
      journey.
    stats: 'Speed: 12.0 (Standard)

      Dash Cooldown: 1.5s

      Specialty: Balanced
      Maneuverability'
    mainSprite: {fileID: 21300000, guid: 5c182baa006d5ec4b88812df5d242ed5, type: 3}
    extraSprite: {fileID: 21300000, guid: 3193e56089773804faade7836d5c9a12, type: 3}
  - name: Iron Vanguard
    subtitle: 'Playable Class: Juggernaut'
    description: A heavily armored juggernaut built to withstand intense bombardment.
      Equipped with heavy kinetic shell ammunition.
    stats: 'Speed: 9.5 (Heavy)

      Dash Cooldown: 1.8s

      Specialty: Heavy
      Kinetic Shells'
    mainSprite: {fileID: 21300000, guid: f89f705d4ba20d9449e1080e8a623b46, type: 3}
    extraSprite: {fileID: 21300000, guid: 2243d23f0da049f4ab41c8f927342cb6, type: 3}
  - name: Nova Prism
    subtitle: 'Playable Class: Assault'
    description: A prototype vessel harnessing stellar energy crystals. Fires concentrated
      energy bolts in wide arcs.
    stats: 'Speed: 11.5 (Moderate)

      Dash Cooldown: 1.4s

      Specialty: Wide
      Spread Fire'
    mainSprite: {fileID: 21300000, guid: 6287f3b68cbbb3448bb40ffb3cfc6146, type: 3}
    extraSprite: {fileID: 21300000, guid: 0b1797ebdc970d346ac210e7bf2fddf4, type: 3}
  - name: Shadow Wraith
    subtitle: 'Playable Class: Stealth'
    description: An advanced stealth fighter designed for hit-and-run tactics. Fades
      into the cosmic dark, firing high-velocity phantom rounds.
    stats: 'Speed: 13.0 (Fast)

      Dash Cooldown: 1.2s

      Specialty: Agile
      Stealth Dash'
    mainSprite: {fileID: 21300000, guid: a993d47853336664f95ff525790d2bab, type: 3}
    extraSprite: {fileID: 21300000, guid: 83e3cd133591d0d40b11fb21b402c2c0, type: 3}
  - name: Star Swift
    subtitle: 'Playable Class: Recon'
    description: Engineered purely for extreme speed and precision. Dart through
      enemy lines and fire lightning-fast photon bursts.
    stats: 'Speed: 15.0 (Extreme)

      Dash Cooldown: 1.0s

      Specialty: Rapid
      Fire Photon Bursts'
    mainSprite: {fileID: 21300000, guid: 16fb1566d0253474c95e5ae459035f52, type: 3}
    extraSprite: {fileID: 21300000, guid: 0831b73aa37795345af191ec588185cc, type: 3}
  arsenal:
  - name: Repair Kit
    subtitle: 'Power-up: Health Recovery'
    description: Restores a portion of your spaceship's hull integrity. Instantly
      repairs critical damage sustained in combat.
    stats: 'Hull Restoration: +1 Health

      Category: Recovery

      Effect:
      Instant Health gain'
    mainSprite: {fileID: 21300000, guid: 64928f620836c994a922ef9dfcb04fa8, type: 3}
    extraSprite: {fileID: 0}
  - name: Energy Shield
    subtitle: 'Power-up: Shield Shielding'
    description: Deploys a temporary energy shield around your ship. Absorbs one
      incoming enemy projectile or collision completely.
    stats: 'Duration: Temporary / Until Hit

      Category: Defensive

      Effect:
      Invincibility Frame'
    mainSprite: {fileID: 21300000, guid: 7dd11da620846ad44b4466676b607092, type: 3}
    extraSprite: {fileID: 0}
  - name: Triple Fire Upgrade
    subtitle: 'Power-up: Weapon Tier Up'
    description: Upgrades your ship's primary weapon system. Adds additional diagonal
      fire lanes, expanding your coverage.
    stats: 'Weapon Tier: Multi-Shot Upgrade

      Category: Offensive

      Effect:
      Wide Angle Spread'
    mainSprite: {fileID: 21300000, guid: f0128ae0822f02d4d91002ed1dd5c586, type: 3}
    extraSprite: {fileID: 0}
  - name: Mega Bomb
    subtitle: 'Power-up: Area Clearer'
    description: Detonates a localized antimatter explosion. Instantly obliterates
      all minor enemy ships and clears active hostile bullets.
    stats: 'Damage: Overwhelming Area Damage

      Category: Ultimate Tactical

      Effect:
      Screen Wipe'
    mainSprite: {fileID: 21300000, guid: c20654fd12ca7d541a4efdf91bd36a56, type: 3}
    extraSprite: {fileID: 0}
  - name: Thruster Spark
    subtitle: 'Power-up: Speed Booster'
    description: Overcharges your engine thrusters, temporarily increasing movement
      speed and dash responsiveness.
    stats: 'Speed Boost: +25% Velocity

      Category: Utility Booster

      Effect:
      Agile Evasion'
    mainSprite: {fileID: 21300000, guid: 64eabeb72d02c2e488c37046dd8f15fb, type: 3}
    extraSprite: {fileID: 0}
  - name: Item Magnet
    subtitle: 'Power-up: Auto Magnetizer'
    description: Generates an electromagnetic field that pulls all floating items
      and power-ups directly towards your ship.
    stats: 'Attraction Radius: Full Screen

      Category: Harvesting Utility

      Effect:
      Automated Collection'
    mainSprite: {fileID: 21300000, guid: ceaedc34cd9d9f047a9b8c1b0e579e47, type: 3}
    extraSprite: {fileID: 0}
  enemies:
  - name: Drone Scout
    subtitle: 'Threat Class: Minor Swarm'
    description: Lightweight scout ships deployed by the enemy vanguard. Weak durability
      but they attack in high-speed formations.
    stats: 'HP: Low

      Speed: Fast

      Weapon Type: Light Blaster

      Threat
      Assessment: Green (Low)'
    mainSprite: {fileID: 21300000, guid: ceeacec592d8d9e4b81c6db45a71e905, type: 3}
    extraSprite: {fileID: 0}
  - name: Hunter Interceptor
    subtitle: 'Threat Class: Targeted Hunter'
    description: Heavy interceptors programmed to track the player's position. They
      fire precise targeting lasers and move aggressively.
    stats: 'HP: Medium

      Speed: Tracking

      Weapon Type: Precision Sniper
      Laser

      Threat Assessment: Orange (Medium)'
    mainSprite: {fileID: 21300000, guid: 9b5f275d4210a3140a4e801550ab073e, type: 3}
    extraSprite: {fileID: 0}
  - name: Gargantuan Command Ship
    subtitle: 'Threat Class: Boss Dreadnought'
    description: The command flagship of the invading fleet. Spans multiple stages
      of attack patterns, deploying shields, drones, and mega energy rays.
    stats: 'HP: Catastrophic

      Speed: Positional Maneuvers

      Weapon Type:
      Extreme Bullet Barrage

      Threat Assessment: Red (Critical)'
    mainSprite: {fileID: 21300000, guid: e87dbe486412c62448abeb59751d97b2, type: 3}
    extraSprite: {fileID: 0}
  - name: Proximity Space Mine
    subtitle: 'Threat Class: Static Hazard'
    description: Static explosive mines floating in the asteroid belts. Explodes
      on impact or when shot, releasing dangerous debris.
    stats: 'HP: High Obstacle

      Speed: Stationary

      Weapon Type: Area Shrapnel
      Blast

      Threat Assessment: Yellow (Caution)'
    mainSprite: {fileID: 0}
    extraSprite: {fileID: 0}
  itemNameText: {fileID: 436925328}
  itemSubtitleText: {fileID: 1507702773}
  itemDescriptionText: {fileID: 646755105}
  itemStatsText: {fileID: 62081745}
  itemMainImage: {fileID: 324115877}
  itemExtraImage: {fileID: 1199161295}
  extraImageContainer: {fileID: 1890425591}
  prevButton: {fileID: 170929583}
  nextButton: {fileID: 214539932}
  closeButton: {fileID: 923336791}
  shipsTabButton: {fileID: 1780795808}
  arsenalTabButton: {fileID: 1354601070}
  enemiesTabButton: {fileID: 1969799802}
  activeTabColor: {r: 0, g: 1, b: 1, a: 1}
  inactiveTabColor: {r: 0.7, g: 0.7, b: 0.7, a: 0.6}
